@model ShowtimeIndexViewModel

@{
    ViewData["Title"] = "Showtimes";

    string SortUrl(string column) => Url.Action("Index", new
    {
        searchTerm = Model.SearchTerm,
        sortColumn = column,
        sortDirection = Model.OppositeSortDirection(column),
        page = 1,
        pageSize = Model.PageSize
    })!;

    string SortIcon(string column) =>
        Model.SortColumn == column
            ? (Model.SortDirection == "asc"
                ? "bi-sort-down"
                : "bi-sort-up")
            : "bi-arrow-down-up text-muted";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>
            <i class="bi bi-camera-reels-fill"></i>
            Movie Showtimes
        </h1>
        <p class="text-muted mb-0">
            Manage movie schedules, genres, screening times, and ticket prices.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i>
        Add New Showtime
    </a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control"
               placeholder="Search by movie code, title, or genre..." />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i>
            Search
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    }

    <input type="hidden" name="sortColumn" value="@Model.SortColumn" />

    <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
</form>

<p class="text-muted">
    Showing @Model.Showtimes.Count() of @Model.TotalRecords total record(s)

    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <span>
            matching "<strong>@Model.SearchTerm</strong>"
        </span>
    }
</p>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle shadow-sm bg-white">
        <thead class="table-dark">
            <tr>
                <th>
                    <a class="text-white text-decoration-none" href="@SortUrl("MovieCode")">
                        Movie Code
                        <i class="bi @SortIcon("MovieCode")"></i>
                    </a>
                </th>

                <th>
                    <a class="text-white text-decoration-none" href="@SortUrl("Title")">
                        Movie Title
                        <i class="bi @SortIcon("Title")"></i>
                    </a>
                </th>

                <th>
                    <a class="text-white text-decoration-none" href="@SortUrl("Genre")">
                        Genre
                        <i class="bi @SortIcon("Genre")"></i>
                    </a>
                </th>

                <th>
                    <a class="text-white text-decoration-none" href="@SortUrl("ShowDateTime")">
                        Show Date and Time
                        <i class="bi @SortIcon("ShowDateTime")"></i>
                    </a>
                </th>

                <th>
                    <a class="text-white text-decoration-none" href="@SortUrl("TicketPrice")">
                        Ticket Price
                        <i class="bi @SortIcon("TicketPrice")"></i>
                    </a>
                </th>

                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var showtime in Model.Showtimes)
            {
                <tr>
                    <td>
                        <span class="badge bg-secondary">
                            @showtime.MovieCode
                        </span>
                    </td>

                    <td>
                        <strong>@showtime.Title</strong>
                    </td>

                    <td>@showtime.Genre</td>

                    <td>
                        @showtime.ShowDateTime.ToString("MMM d, yyyy h:mm tt")
                    </td>

                    <td>@showtime.TicketPrice.ToString("C")</td>

                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@showtime.ShowtimeId" class="btn btn-sm btn-outline-info"
                           title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>

                        <a asp-action="Edit" asp-route-id="@showtime.ShowtimeId" class="btn btn-sm btn-outline-primary"
                           title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <a asp-action="Delete" asp-route-id="@showtime.ShowtimeId" class="btn btn-sm btn-outline-danger"
                           title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }

            @if (!Model.Showtimes.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No showtimes found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Showtime list pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("Index", new
                   {
                       searchTerm = Model.SearchTerm,
                       sortColumn = Model.SortColumn,
                       sortDirection = Model.SortDirection,
                       page = Model.CurrentPage - 1,
                       pageSize = Model.PageSize
                   })">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new
                       {
                           searchTerm = Model.SearchTerm,
                           sortColumn = Model.SortColumn,
                           sortDirection = Model.SortDirection,
                           page = i,
                           pageSize = Model.PageSize
                       })">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("Index", new
                   {
                       searchTerm = Model.SearchTerm,
                       sortColumn = Model.SortColumn,
                       sortDirection = Model.SortDirection,
                       page = Model.CurrentPage + 1,
                       pageSize = Model.PageSize
                   })">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}