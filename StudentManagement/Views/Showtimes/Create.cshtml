@model ShowtimeViewModel

@{
    ViewData["Title"] = "Add New Showtime";
}

<h1>
    <i class="bi bi-calendar-plus-fill"></i>
    Add New Showtime
</h1>

<p class="text-muted">
    Enter the movie and screening schedule information.
</p>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="MovieCode" class="form-label"></label>

                    <input asp-for="MovieCode" class="form-control" placeholder="e.g. MV-001" />

                    <span asp-validation-for="MovieCode" class="text-danger"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="Title" class="form-label"></label>

                    <input asp-for="Title" class="form-control" placeholder="e.g. Inside Out 2" />

                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Genre" class="form-label"></label>

                    <input asp-for="Genre" class="form-control" placeholder="e.g. Animation" />

                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ShowDateTime" class="form-label"></label>

                    <input asp-for="ShowDateTime" type="datetime-local" class="form-control" />

                    <span asp-validation-for="ShowDateTime" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="TicketPrice" class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">$</span>

                        <input asp-for="TicketPrice" type="number" min="0.01" step="0.01" class="form-control"
                               placeholder="0.00" />
                    </div>

                    <span asp-validation-for="TicketPrice" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i>
                Save Showtime
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i>
                Cancel
            </a>
        </form>
    </div>
</div>